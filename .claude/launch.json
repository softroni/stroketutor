{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "papercoach-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "ios-design",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "docs/ios-design"
      ],
      "port": 4173
    }
  ]
}