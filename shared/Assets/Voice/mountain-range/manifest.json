    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Mountains lose their color in the distance. These peaks are blue, the snow is gray and the hills in front are the darkest green on the page. Watch the layers pile up, then send your own peaks back.",
      "textHash": "eab295a2bae2405f9b64f2392060a3023c2c56861e293396bcbe9bb29b657a36",
      "durationMs": 12160
    },
    "ground": {
      "file": "ground.m4a",
      "text": "Everything stands on one level line. Draw it near the bottom.",
      "textHash": "8b43543c1791161bc1115c68e5d4846c03fe90f1f4dd5ed7c2a568676b10fa77",
      "durationMs": 3840
    },
    "peaks": {
      "file": "peaks.m4a",
      "text": "Three peaks in a row. Up and down for the left one, then the middle, then the right.",
      "textHash": "89bf399d8356d5176e78bf345a6a85d6d9d5c321041eed2a922b42027bc3f818",
      "durationMs": 5680
    },
    "snow": {
      "file": "snow.m4a",
      "text": "Snow caps the outer two. Draw a wobbly line under each cap.",
      "textHash": "2c92ddd76778cf924916681003b751f42657d83f448612b42f8797b8169ba1ab",
      "durationMs": 4560
    },
    "front-hill": {
      "file": "front-hill.m4a",
      "text": "The front hill sweeps up from the left corner, over to the right.",
      "textHash": "e7ead56d1e26dea6299238d9ab0c165b3a99dd71a6cbf11ad922b2b01cc7a112",
      "durationMs": 3600
    },
    "back-hill": {
      "file": "back-hill.m4a",
      "text": "A low green hill rises on the right and runs into the mountain.",
      "textHash": "c8dce85df2983c847dc0af119099a2500ddb42001269b5c6acd29a0e61fadf19",
      "durationMs": 4080
    },
    "left-trees": {
      "file": "left-trees.m4a",
      "text": "Two pines on the left hill. Trunk and spiky top, then a small one with no trunk.",
      "textHash": "eab7a62c672b70a91b4706dcc8b2d5f2f133d4fac949084832b4e5dd3c8ed011",
      "durationMs": 6080
    },
    "right-trees": {
      "file": "right-trees.m4a",
      "text": "Two more on the right. Spiky top first, then a trunk under each.",
