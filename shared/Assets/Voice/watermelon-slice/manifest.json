  "steps": {
    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Here comes a summer favorite, a slice of watermelon. See how the slice is built, then you draw it.",
      "textHash": "eeb7439887fb2927baf1a39325e51a113df7e84f8a18bd4f8a1f541c308f1aaa",
      "durationMs": 5920
    },
    "left-side": {
      "file": "left-side.m4a",
      "text": "The slice is a big triangle. From the tip, draw a straight line down to the left.",
      "textHash": "b371fb04991224e10fccee7983e11e2c8d9f64023d7d675dc05df2ca779838dd",
      "durationMs": 5360
    },
    "right-side": {
      "file": "right-side.m4a",
      "text": "Now the other side. From the tip again, straight down to the right.",
      "textHash": "77ea0d140b6492180e4d9c8787707fa426b07518ce3ed38681c415beced3a500",
      "durationMs": 4400
    },
    "bottom": {
      "file": "bottom.m4a",
      "text": "Close the slice with a curved bottom, like a wide smile.",
      "textHash": "22e8c9877763d18060f99e5f0ce32ca3c9e94592c12bd8ea1b5f7c3699e0aba5",
      "durationMs": 3760
    },
    "rind-top": {
      "file": "rind-top.m4a",
      "text": "Next, the rind. Draw a curve from side to side, just above the bottom.",
      "textHash": "93b07b2184a079bc654cce791ff0551ebdf0f4c412d58a1a727649b7cc908d37",
      "durationMs": 5680
    },
    "rind-bottom": {
      "file": "rind-bottom.m4a",
      "text": "Add one more curve under it. Now the rind has a stripe.",
      "textHash": "93494acb2360a867f546ae8b16a389d79055f09cf1994cfc073001c3220ca81e",
      "durationMs": 4000
    },
    "seeds-top": {
      "file": "seeds-top.m4a",
      "text": "Time for seeds. Draw two little teardrops near the top.",
      "textHash": "cf00de2ccdfd04253d23f831d27401828788e6520964d29cd1a81012a40aadf3",
      "durationMs": 4160
    },
    "seeds-bottom": {
      "file": "seeds-bottom.m4a",
      "text": "Three more teardrops go in a row below them.",
      "textHash": "e020c12f04bd06d3b540c57848d96b0aba8be17c6161813edab41d4f72ef5cae",
      "durationMs": 3040
    },
    "flesh": {
      "file": "flesh.m4a",
      "text": "Color the inside pink.",
      "textHash": "3c9d076a3d9d5b06655791ab74e38de1b82eff01283ef20445e29d9d25760043",
      "durationMs": 1840
    },
    "rind": {
      "file": "rind.m4a",
      "text": "Make the rind dark green.",
      "textHash": "659cd280a59b5ae615d8f871c3e47c2e3c471f2534d4f3ada299c37cc3d7b0dc",
      "durationMs": 2320
    },
    "stripe": {
      "file": "stripe.m4a",
      "text": "Fill the thin stripe light green.",
      "textHash": "ab4e80d9270ea7cc2b39879cc7f1f817b023b962bdc657e8613cc8ca1c8e7a0c",
      "durationMs": 2480
    },
    "seeds": {
      "file": "seeds.m4a",
      "text": "The seeds are black.",
      "textHash": "73266c78030f41f44178322c0c289ffa0ab27cb6ac3ac6238cbdfab11453eb98",
      "durationMs": 1600
    },
    "lesson-outro": {
      "file": "lesson-outro.m4a",
      "text": "That's your watermelon slice. It looks cold and sweet, and you drew every seed.",
      "textHash": "4b027186d87c15b1fd1d03683fe45255ca76ef82da375a6f331810320640ed96",
      "durationMs": 5040
