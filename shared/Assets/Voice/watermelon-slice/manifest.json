{
  "manifestVersion": 1,
  "lessonId": "watermelon-slice",
  "voiceId": "lina-bright",
  "voiceName": "Lina, bright",
  "model": "qwen-base clone of lina-lina-bright-09cf35",
  "generatedAt": "2026-09-25T03:10:10.690Z",
  "steps": {
    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "On a hot summer day, nothing beats a cold slice of watermelon. It's a triangle with a curved bottom and a stripy rind. Watch the slice take shape, then serve yourself one.",
      "textHash": "83688a5a536fc1d66b4058ef3f4b1ebdfdf325d779b47e721beb19df01f8cf77",
      "durationMs": 10960
    },
    "left-side": {
      "file": "left-side.m4a",
      "text": "A watermelon slice starts as a tall triangle. From the top point, slide straight down to the left.",
      "textHash": "af43878b802ab392107188511dce7e2d4a50121b2e4488110f84092bf4180c98",
      "durationMs": 6640
    },
    "right-side": {
      "file": "right-side.m4a",
      "text": "Back to the point, and slide down to the right the same way.",
      "textHash": "6a16ca70194f3fb3a82984bd4b2566f1e38cf8f9950525b050a0e93114830c0d",
      "durationMs": 3760
    },
    "bottom": {
      "file": "bottom.m4a",
      "text": "The bottom is curved. Join the two corners with a line that dips low, like a bowl.",
      "textHash": "4f9b0024b0454a1f1eb5961cd5fbcabf6c9c8d77de26cd8bd7971482fa13f53c",
      "durationMs": 5120
    },
    "rind-top": {
      "file": "rind-top.m4a",
      "text": "Now the rind. Draw a curve across the slice, a little above the bottom.",
      "textHash": "19e73d2fb8acb42a4517e7a8c51bfde7607e7dbc47dd5603c0cf0a3fdde087e7",
      "durationMs": 5200
    },
    "rind-bottom": {
      "file": "rind-bottom.m4a",
      "text": "One more curve fits between those two. That makes a thin stripe.",
      "textHash": "c10f9bf4189fab771ea9f4ba6e497b0e28c525851cad310b18affc67824a0a47",
      "durationMs": 4480
    },
    "seeds-top": {
      "file": "seeds-top.m4a",
      "text": "Watermelons are full of seeds. Draw two small teardrops near the top, pointing up.",
      "textHash": "8e00eb94aea0e1263f326384f01e27aa930f60e7a866fa7a28f8245a69f4db1b",
      "durationMs": 5760
    },
    "seeds-bottom": {
      "file": "seeds-bottom.m4a",
      "text": "Three more teardrops sit in a row underneath. That's five seeds.",
      "textHash": "9fedab5496bd877b8170cf8f3e8ac234e894bc5e1eb6bc8e2361e11760dd2129",
      "durationMs": 4320
    },
    "flesh": {
      "file": "flesh.m4a",
      "text": "Color the inside pink.",
      "textHash": "3c9d076a3d9d5b06655791ab74e38de1b82eff01283ef20445e29d9d25760043",
      "durationMs": 1840
    },
    "rind": {
      "file": "rind.m4a",
      "text": "Color the rind dark green.",
      "textHash": "016f39b3ec0d3d3c07fcbe4734a3ab1cec6c604c805cbd22215824f5fa682890",
      "durationMs": 2240
    },
    "stripe": {
      "file": "stripe.m4a",
      "text": "The stripe is light green.",
      "textHash": "db3c3ef6440fce589b62f2b04ac70618a8a377e84899b563cd952e19a72f4e5d",
      "durationMs": 2000
    },
    "seeds": {
      "file": "seeds.m4a",
      "text": "Color all five seeds black.",
      "textHash": "6c40922ebace4fc16654b46dad4896482e4a6a112792f93c4ccfe21a664af9f6",
      "durationMs": 2480
    },
    "lesson-outro": {
      "file": "lesson-outro.m4a",
      "text": "Pink inside, green outside and five black seeds. You can almost hear the crunch.",
      "textHash": "8d77c1982ae79e7e452558cf402227089a2960aff56716d82073647c866696d0",
      "durationMs": 5280
    }
  }
}
