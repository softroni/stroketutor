  "steps": {
    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Strawberries wear their seeds on the outside, and a leafy green hat on top. We'll draw the hat first, then the berry. Watch it once, then it's all yours.",
      "textHash": "7e07085b155d67479e401ad649a1f0823be7f6c4dc7c79fa97356cd2198d2dd8",
      "durationMs": 9760
    },
    "left-leaves": {
      "file": "left-leaves.m4a",
      "text": "Start with the leafy hat. Draw a pointed leaf curling up to the left.",
      "textHash": "beefa7857ca05b0afe556236e4e931a207dd70b3f8e69e05718c3cbeb761d4c8",
      "durationMs": 4560
    },
    "right-leaves-2": {
      "file": "right-leaves-2.m4a",
      "text": "Now its twin on the right, curling up the other way.",
      "textHash": "ac9e15df508656c95a04965b3c83804e59edecd9067110f4f243b30202b0e43b",
      "durationMs": 3680
    },
    "right-leaves": {
      "file": "right-leaves.m4a",
      "text": "A short stem pokes up between the two leaves. Up, across the top and down.",
      "textHash": "2a8696d1a7b7ed6815a960329ace10712a49f10da2780a1af0677d5bc994614e",
      "durationMs": 5200
    },
    "middle-leaf": {
      "file": "middle-leaf.m4a",
      "text": "One leaf hangs down in the middle, a narrow letter V.",
      "textHash": "21e5e7e9150354c0cca36abca15cb8fb0b452ae505ac28c3336899a0f495ae94",
      "durationMs": 4160
    },
    "leaf-edges": {
      "file": "leaf-edges.m4a",
      "text": "Finish the hat with the bottom edge of the leaves, one on each side, out to the tips.",
      "textHash": "d2df994b4e58da98e3ade0b066bb2599a5c4cf444d5656e798ae9e47ce5fdab6",
      "durationMs": 5360
    },
    "berry": {
      "file": "berry.m4a",
      "text": "The berry is shaped like a heart. Curve down from the leaves to a soft point, and back up.",
      "textHash": "33b524136ee581a741686a89826366d0586e3cebe280a687f165218162d20df4",
      "durationMs": 6000
    },
    "red": {
      "file": "red.m4a",
      "text": "Color the berry red.",
      "textHash": "85cb136301042fa7ea6e1959602f28be96a880b7a98bbf3a49e18cdc760fc4c9",
      "durationMs": 1680
    },
    "seeds": {
      "file": "seeds.m4a",
      "text": "Color the six seeds black.",
      "textHash": "13c9362c883491f4c40e3b3d52fe0ef9f4ebb10ac9847382b0b2c51555b59bab",
      "durationMs": 2240
    },
    "green": {
      "file": "green.m4a",
      "text": "The leaves and the stem are green.",
      "textHash": "b431be098f91a1d8b1e78114d1f4b58d9b6b11e7e723a117f5e90fe9bd0919f2",
      "durationMs": 2160
    },
    "lesson-outro": {
      "file": "lesson-outro.m4a",
      "text": "Six seeds, a leafy hat and one juicy berry. That's the best strawberry in the patch.",
      "textHash": "a07d25cec0c71a60eb99894362bbdde1f9ecb2653ca64f6690929ca297f8e587",
      "durationMs": 6240
    }
  }
}
