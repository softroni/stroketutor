    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Today we’re drawing a mountain valley. Watch how it comes together, then it’s your turn.",
      "textHash": "ee7bc4c5b7d48298d05ea6b3f94ff103692800151cabafe225cbed19890eafa0",
      "durationMs": 5280
    },
    "lines": {
      "file": "lines.m4a",
      "text": "Two level lines: one along the bottom, one where the grass ends.",
      "textHash": "d5c0b541fc90271e0c479349cac0bf449d0466d9c428575935dd882e2f71eef7",
      "durationMs": 4560
    },
    "peaks": {
      "file": "peaks.m4a",
      "text": "Two mountains sit on the far line, two straight slopes each.",
      "textHash": "ae85ace53b90fa4386316626a7e2fa2ad71e699142ea38382ddd43c91e7385fd",
      "durationMs": 4320
    },
    "river": {
      "file": "river.m4a",
      "text": "The river runs from the bottom up to where the mountains meet. Both banks.",
      "textHash": "a5acdf430f2f6789ec769fe89cd8fd19f5c93eaa74079db536d91b0ca70db6b2",
      "durationMs": 4960
    },
    "cabin": {
      "file": "cabin.m4a",
      "text": "A small cabin on the right: square wall, pointed roof, one door.",
