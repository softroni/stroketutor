  "steps": {
    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "A pear is shaped a bit like a light bulb, small on top and round and heavy at the bottom. Watch the curves swell out, then draw a pear of your own.",
      "textHash": "f8a935e3a1463ae15fa32fa974caf85badb18728f58abe1d7b9dd00ee6a4a88e",
      "durationMs": 9360
    },
    "left-side": {
      "file": "left-side.m4a",
      "text": "The pear starts narrow at the top. Go down the left side, then bulge out wide and round to the bottom.",
      "textHash": "a10fd602113153e83003f1583cdcacbbd87f03a722927517dbdb4e3e47b9bebf",
      "durationMs": 6560
    },
    "right-side": {
      "file": "right-side.m4a",
      "text": "Now the right side, the same shape turned around. Its bottom meets the first one.",
      "textHash": "09b1b2bb281faab236043016635765785be70479c284cf35d9e117737d37f8e6",
      "durationMs": 5040
    },
    "stem": {
      "file": "stem.m4a",
      "text": "The stem leans a little to the left. Draw it up from the top, round the end and back down.",
      "textHash": "8b62e0e9e750d3c082109d5c2495bd74038189cc92f5e5064ec6c8169e23ec3e",
      "durationMs": 6560
    },
    "leaf": {
      "file": "leaf.m4a",
      "text": "A leaf sticks out to the right, high on the stem. Out to a sharp tip and back again.",
      "textHash": "e06005020d76bf3a2cb470d8a517b6a9e1926728cd8e9a263d6509bc213d0949",
      "durationMs": 5760
    },
    "vein": {
      "file": "vein.m4a",
      "text": "Now one straight line through the middle of the leaf.",
      "textHash": "c0ef3416f680f394293d2bff4fabac15a764d833d947f95a81f38fbe52aefb56",
      "durationMs": 2960
    },
    "pear-green": {
      "file": "pear-green.m4a",
      "text": "Color the pear light green.",
      "textHash": "342facede263469c5e00f0a77ea644a569389ac00e37d7ac46e6e02aac16710c",
      "durationMs": 1920
    },
    "leaf-green": {
      "file": "leaf-green.m4a",
      "text": "Color the leaf green.",
      "textHash": "f0468673f7ab02957274c66358409f512b75fc9e177d180b583279f879636c58",
      "durationMs": 1440
    },
    "stem-brown": {
      "file": "stem-brown.m4a",
      "text": "The stem is brown.",
      "textHash": "591c76ba90a92211e409fd78bcf80dc8226b342d98e01e9c05015ead76a5b730",
      "durationMs": 1360
    },
    "lesson-outro": {
      "file": "lesson-outro.m4a",
      "text": "Round at the bottom, narrow at the top. That pear looks juicy enough to drip.",
      "textHash": "78b020ed15d8c002aecda6ca0fa54732eb32ea19944e742327a29d5a7ab830cc",
      "durationMs": 6000
    }
  }
}
