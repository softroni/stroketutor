  "steps": {
    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Apples grow on trees, and this one is ready to pick. It's a round apple with a dip on top, a stem and one leaf. Watch it come around, then pick one of your own.",
      "textHash": "236f6d3620b720d93d61cbb311b9c90285e3649f22ce5e13e1c8aaf3f0ff817e",
      "durationMs": 11360
    },
    "left-side": {
      "file": "left-side.m4a",
      "text": "An apple is a fat circle with a dip on top. From the dip, round the left side down to the bottom.",
      "textHash": "25afda6b7a6ad9c06e061353f070c34cba918aec7ee2d816a7248263fcc047cf",
      "durationMs": 6400
    },
    "right-side": {
      "file": "right-side.m4a",
      "text": "Now the right side. Start in the dip again and round it down until the two ends meet.",
      "textHash": "57ac7bc6d5f32fdb74598d25c972488d1cd820ab392b0b1ff01f1d0cb06770a5",
      "durationMs": 5200
    },
    "stem": {
      "file": "stem.m4a",
      "text": "Poke a short stem up out of the dip. Up, over its little top, and back down.",
      "textHash": "561d814622aef66c8bc3a08a27fc8ef7493889d2a74fc9282aef34542df3c359",
      "durationMs": 5440
    },
    "leaf": {
      "file": "leaf.m4a",
      "text": "A leaf hangs off the stem. Swoop out to a point and back, like a little boat.",
      "textHash": "80672b75aeca6d15843241b8955bb4c4f0de2eab972d31cdbd0ab74443326aaa",
      "durationMs": 5280
    },
    "vein": {
      "file": "vein.m4a",
      "text": "Give the leaf a vein, one line from the stem toward the point.",
      "textHash": "fe69596bc187ffcb8d6acd9da41a430fe9adba24ac3090c7ba25b47d5836a616",
      "durationMs": 4400
    },
    "red": {
      "file": "red.m4a",
      "text": "Color the apple red.",
      "textHash": "88a2328a2f292d95c4b54309873b8041dedd098cd9c7e2808d93442b3a790005",
      "durationMs": 1680
    },
    "green": {
      "file": "green.m4a",
      "text": "The leaf is green.",
      "textHash": "5aa1d27a3fa8a794f149cd065eae742af70ad06444c2928982220f24fabdae86",
      "durationMs": 1520
    },
    "brown": {
      "file": "brown.m4a",
      "text": "Color the stem brown.",
      "textHash": "bb4313fd841e0b74b00594ac1ecae516ceed19efe4f3a61fc23ce8d17358d09b",
      "durationMs": 1920
    },
    "lesson-outro": {
      "file": "lesson-outro.m4a",
      "text": "One shiny apple with a leaf on top. Will you eat it, or give it to your teacher?",
      "textHash": "b4c4ff7169ef514269cdcf2d84e99a47dfb4d6e58ca014118dbd4dd0990663fa",
      "durationMs": 5040
    }
  }
}
