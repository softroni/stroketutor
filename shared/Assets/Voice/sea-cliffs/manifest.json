    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Two cliffs reach out into the sea, one behind the other, and a lone rock stands out in the water. Watch the second cliff stop where the first one gets in its way, then walk your own coast.",
      "textHash": "361fda3d5f588482454281abd5097f2e1b861e34ec782c6de4ce4f049b73eabf",
      "durationMs": 11520
    },
    "near-top": {
      "file": "near-top.m4a",
      "text": "The near cliff is a tall block. Draw its left edge and its flat top.",
      "textHash": "4e0aeac0d7810e2f11009d670fbc3fe9b2af09e52de66bbd4f1141fc83170e8f",
      "durationMs": 5360
    },
    "near-top-2": {
      "file": "near-top-2.m4a",
      "text": "From the top corner, down the cliff face and along the foot.",
      "textHash": "38a518d0075ab0631a741cdc18aa09f8b486abad4aa6824136de250f7f7bc1bc",
      "durationMs": 3680
    },
    "far-cliff": {
      "file": "far-cliff.m4a",
      "text": "A second cliff steps down behind it, lower and further right.",
      "textHash": "db810662a839705a6d6e46258ca3a089941ceb1737cd250fafa3df91c6c41d07",
      "durationMs": 4160
    },
    "grass": {
      "file": "grass.m4a",
      "text": "Grass caps both cliffs. A wavy line under each top edge.",
