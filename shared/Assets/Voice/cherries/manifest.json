  "steps": {
    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Cherries grow in pairs, two on one stem, like best friends holding hands. Watch the pair come together, then hang a pair of your own.",
      "textHash": "e66748c94c0f16dde35cefccedaaf520bec364aff38b0e06fe6262ae6e1a25a3",
      "durationMs": 8720
    },
    "front-cherry": {
      "file": "front-cherry.m4a",
      "text": "The front cherry is a circle. From the top, curve down its left side.",
      "textHash": "80ed18fbe54f2674d04970df85d467345fe7b23f81edef58aca1e2039a3c3372",
      "durationMs": 4560
    },
    "front-side": {
      "file": "front-side.m4a",
      "text": "Then round the right side, back to where you began.",
      "textHash": "7084e98f2c2ebb679e0f6b10a8a0a1bef389b9f710c41f1a23b86e8d307cac48",
      "durationMs": 3600
    },
    "back-cherry": {
      "file": "back-cherry.m4a",
      "text": "The second cherry hides behind the first. Draw only the part that peeks out on the left.",
      "textHash": "ef2551a58f0245bc296462447da9dc1609a4a7521f3f14d2453fb2460277319d",
      "durationMs": 4960
    },
    "stems": {
      "file": "stems.m4a",
      "text": "Each cherry has a thin stem. Draw both up from the tops until they meet at one point.",
      "textHash": "ccddebfdd38101e1e73425e78881f2f306d2fab94980e04e11e1d6697629949d",
      "durationMs": 5360
    },
    "leaf": {
      "file": "leaf.m4a",
      "text": "A leaf sprouts where the stems meet. Swing out to the right, to a point, and back.",
      "textHash": "8c459e7208d947058c73b496ae71c815b864221947ef745629184fcb124af3db",
      "durationMs": 5600
    },
    "vein": {
      "file": "vein.m4a",
      "text": "Draw a curved line inside the leaf, from the stems toward the tip.",
      "textHash": "c7f710b92ceae1620ab08c1b6fcfc1a39acb61715d519e920c8081a01010584b",
      "durationMs": 4480
    },
    "red": {
      "file": "red.m4a",
      "text": "Color both cherries red.",
      "textHash": "e57e3ad773ba11c7df9af81e0cec7a1ad5cfecc2324a8cf24c430fb2f5dd6fee",
      "durationMs": 2320
    },
    "green": {
      "file": "green.m4a",
      "text": "Color the leaf green.",
      "textHash": "f0468673f7ab02957274c66358409f512b75fc9e177d180b583279f879636c58",
      "durationMs": 1440
    },
    "lesson-outro": {
      "file": "lesson-outro.m4a",
      "text": "Two cherries sharing one stem. Hang them over your ear and you've got cherry earrings.",
      "textHash": "022283425e5139869eb7eb7a36287fdd7f0b186978192acfd9ad27ab89873846",
      "durationMs": 5920
    }
  }
}
