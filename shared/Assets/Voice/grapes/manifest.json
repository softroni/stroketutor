  "steps": {
    "lesson-intro": {
      "file": "lesson-intro.m4a",
      "text": "Grapes grow in bunches on a vine. Ours has ten grapes piled into a triangle, with a leaf and a curly tendril on top. Count along as they pile up, then make a bunch of your own.",
      "textHash": "2310e9bee9e129dd69e7d0373b7d25f385aa67890b79f19bdaf0578bdb4fdaa8",
      "durationMs": 11200
    },
    "top-row": {
      "file": "top-row.m4a",
      "text": "Every grape is a circle. Line up four across the top, each one touching the next.",
      "textHash": "b44ad604f53063653156bcd98b21edf8929d745f36d2560eec670573b6add36d",
      "durationMs": 5920
    },
    "second-row": {
      "file": "second-row.m4a",
      "text": "Tuck three grapes underneath, each one sitting in a gap above.",
      "textHash": "2f157ded2adaf05f0735cb0269deaedeb4eaed49f87b68631c797d8e2e3f50f2",
      "durationMs": 4480
    },
    "last-grapes": {
      "file": "last-grapes.m4a",
      "text": "Two more below them, and a single grape at the very bottom. That's ten.",
      "textHash": "c53c556a8b6a9113c2466793beb8f418e2edc7a1a59cde0504d2ef85c39ca58f",
      "durationMs": 4800
    },
    "stalk": {
      "file": "stalk.m4a",
      "text": "The bunch hangs from a woody stalk. Draw its outline up from the top row to its knobby end.",
      "textHash": "3ad58c5a04a520917e42027a8070f1a43336023b48c7ef0983a7c52f93bffebb",
      "durationMs": 5520
    },
    "branches": {
      "file": "branches.m4a",
      "text": "Thin twigs reach down from the stalk to the grapes. Draw them in between.",
      "textHash": "495b41c6c6a46ee39395c85fc118fc9c878c6a9311bdc86ce336116cc298b13b",
      "durationMs": 4640
    },
    "leaf": {
      "file": "leaf.m4a",
      "text": "A grape leaf has three points. Draw one on the left, going up and around all three.",
      "textHash": "3a0023510bbbf7e22ac5f10c8c9b964268fa0cbb266e974bb0abdec8141d8413",
      "durationMs": 6320
    },
    "vein": {
      "file": "vein.m4a",
      "text": "One vein runs down the leaf from its middle point.",
      "textHash": "7afd62676f16e6a992a171c76a405668dc85c8051f8c819edd3ba2c52ab90fd8",
      "durationMs": 3200
    },
    "tendril": {
      "file": "tendril.m4a",
      "text": "A tendril is a curly string the vine holds on with. Swing out, loop once, and wiggle off.",
      "textHash": "cf90ee3aabed8df8fd08e3bbbff8d9b03bdde91233bbbc2e5f223a51432e47e2",
      "durationMs": 6080
    },
    "purple": {
      "file": "purple.m4a",
      "text": "Color every grape purple.",
      "textHash": "f598ecdd273876bd13bfcbb337f3d0434dd7b25f31db1bde0675f9bde9354fcb",
      "durationMs": 2000
    },
    "shine": {
      "file": "shine.m4a",
      "text": "Each grape has a small shiny spot. Color the spots light purple.",
      "textHash": "cd6b5800786d230dfb2001031b75acc244b6a1a8bd1d8bf945f85f1ec054dc2b",
      "durationMs": 4960
    },
    "brown": {
      "file": "brown.m4a",
      "text": "The stalk is brown.",
      "textHash": "1bac4b1000874f8626fbd324fec86101f7413a6ad3b3b789c6588c433240bdfc",
      "durationMs": 1680
    },
    "green": {
      "file": "green.m4a",
      "text": "Color the leaf green.",
      "textHash": "f0468673f7ab02957274c66358409f512b75fc9e177d180b583279f879636c58",
      "durationMs": 1440
    },
    "lesson-outro": {
      "file": "lesson-outro.m4a",
      "text": "Ten round grapes and a curly tendril. Would you eat them one at a time, or all at once?",
      "textHash": "da01ca30d09987483e22ae3dde05f566515da41b7bc43470d418625d35d87a44",
      "durationMs": 5440
    }
  }
}
